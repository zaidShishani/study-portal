# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_USER=study
POSTGRES_PASSWORD=change-me
POSTGRES_DB=study_portal
# Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://study:change-me@db:5432/study_portal
FRONTEND_ORIGIN=http://localhost:5173

# Host ports (containers keep 5432/8000/5173). Change these plus
# COMPOSE_PROJECT_NAME to run several stacks side by side; keep
# FRONTEND_ORIGIN matching WEB_PORT.
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
